{
  // Cloudflare Workers 배포 설정 (정적 에셋 전용 Worker)
  //
  // 이 앱은 서버 코드가 없는 순수 정적 사이트라 워커 스크립트("main")가 필요 없다.
  // `yarn build`로 만들어진 dist/ 를 그대로 서빙한다.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "morse-code-translator",
  "compatibility_date": "2026-08-06",
  "assets": {
    // 빌드 산출물 위치. 이 값이 없으면 Cloudflare가 추측하게 된다.
    "directory": "./dist",
    // SPA는 아니지만 라우트가 하나뿐이므로 어떤 경로로 들어와도 index.html을 돌려준다.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
